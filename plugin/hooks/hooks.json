{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v lemma >/dev/null 2>&1 || exit 0; lemma session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v lemma >/dev/null 2>&1 || exit 0; lemma stop"
          }
        ]
      }
    ]
  }
}
